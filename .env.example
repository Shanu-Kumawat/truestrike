# TrueForge server (local default from `npx @truefoundry/trueforge`)
TRUEFORGE_BASE_URL=http://localhost:8790

# Model for the agent, in provider/model form. Must match a provider configured
# in TrueForge Settings > Models.
TRUESTRIKE_MODEL=openai/gpt-5

# Extra authorized scan targets beyond loopback (comma-separated hostnames).
# Default scope is localhost/127.0.0.1 only (where the Juice Shop demo runs).
TRUESTRIKE_ALLOW_HOSTS=

# NOTE: the Daytona sandbox is always enabled (all execution happens inside
# it) and requires a Daytona provider configured in TrueForge
# Settings > Sandbox providers.

# MCP server names (configured in TrueForge Settings > Connectors) to attach to
# the agent. Write/destructive tools on these servers pause for human approval.
# Start the gateway with `pnpm truestrike gateway` and add its /mcp URL as a
# connector named e.g. truestrike-gateway.
TRUESTRIKE_MCP_SERVERS=

# Exploit-gateway MCP server (truestrike gateway)
TRUESTRIKE_GATEWAY_PORT=8815
TRUESTRIKE_AUDIT_LOG=.truestrike/audit.jsonl

# Model provider key (configured in TrueForge Settings > Models; pick what you use)
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Daytona sandbox provider (configured in TrueForge Settings > Sandbox providers)
DAYTONA_API_KEY=
